# ── Node / React ──
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ── Rust / Tauri ──
target/
src-tauri/target/
# Tauri generated bundles
src-tauri/gen/

# ── Python sidecar ──
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Arbora runtime data (never commit user data or models) ──
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
faiss/
models/
*.apkg

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Env / secrets ──
.env
.env.*
!.env.example

# ── Local agent tooling (not needed to build or run Arbora) ──
.claude/
